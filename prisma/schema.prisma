// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  image         String?
  plan          String    @default("MEMBER") // GUEST, MEMBER, PRO
  planUpdatedAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  credits       MonthlyCredit[]
  waitlists     Waitlist[]
  events        ExperimentEvent[]
  projects      Project[]
}

model MonthlyCredit {
  id         String   @id @default(uuid())
  userId     String
  period     String   // Format: "YYYY-MM"
  draftUsed  Int      @default(0)
  finalUsed  Int      @default(0)
  draftLimit Int      @default(80)
  finalLimit Int      @default(1)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

model Waitlist {
  id            String   @id @default(uuid())
  userId        String?
  email         String
  roleCategory  String?
  useCaseText   String?
  willingness   Boolean  @default(false) // "would_pay_now"
  priceComfort  String?
  sourceAction  String?
  
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id])
}

model ExperimentEvent {
  id          String   @id @default(uuid())
  userId      String?
  anonId      String?
  eventName   String
  properties  String?  // JSON string
  userState   String?
  
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

model Project {
  id           String   @id @default(uuid())
  userId       String?
  title        String
  lastModified DateTime @updatedAt
  scenes       Json     @default("[]") // Storing scenes structure as JSON
  globalContext String? @default("")
  createdAt    DateTime @default(now())
  
  user         User?    @relation(fields: [userId], references: [id])
}
